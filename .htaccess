<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /ict-assist/

  RewriteRule ^employee-dashboard\.html$ dashboard.php [L,QSA]
  RewriteRule ^new-request\.html$ new_request.php [L,QSA]
  RewriteRule ^ticket-status\.html$ dashboard.php#tickets-section [R=302,L,NE]
  RewriteRule ^notifications\.html$ notifications.php [L,QSA]
  RewriteRule ^profile\.html$ profile.php [L,QSA]
  RewriteRule ^coordinator-dashboard\.html$ switch_view.php?role=coordinator [R=302,L,QSA]
  RewriteRule ^staff-dashboard\.html$ switch_view.php?role=staff [R=302,L,QSA]
</IfModule>
